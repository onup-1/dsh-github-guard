{
  "name": "dsh-github-guard",
  "version": "0.1.0",
  "description": "Keeps github.com reachable from DSH: watches GitHub traffic, probes the rotating edge IPs, and asks a tiny SYSTEM helper to rewrite the hosts pins.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "hosts",
    "dns",
    "connectivity",
    "network"
  ],
  "author": "onup-1",
  "homepage": "https://github.com/onup-1/dsh-github-guard#readme",
  "bugs": {
    "url": "https://github.com/onup-1/dsh-github-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onup-1/dsh-github-guard.git"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "native/dsh-github-guard.cs",
    "native/dsh-github-guard.exe",
    "scripts/install-helper.ps1",
    "scripts/uninstall-helper.ps1",
    "scripts/build-native.ps1",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
